rules_version = '2';

// These rules are the actual security boundary for Firebase on this site —
// the client config in js/firebase-config.js is public by design (see
// README "Is Firebase safe here?"). Everything here is deliberately
// increment-only: no client can set an arbitrary value, decrement a
// counter, or touch any field/collection not listed below.
service cloud.firestore {
  match /databases/{database}/documents {

    // The app directory itself — what gets listed and opened in the
    // in-page viewer. Public read (it's a public directory), but NO client
    // write at all: if this were writable, anyone could inject an
    // arbitrary URL into the site and have it load inside your iframe
    // viewer. Add/edit entries via the Firebase Console or
    // scripts/add-app.mjs (both use your own credentials, not the client
    // SDK, so they bypass these rules entirely — that's expected).
    match /apps/{appId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-app play counts, used to sort the directory by popularity.
    // Docs are pre-created by scripts/seed-firebase.mjs — clients can only
    // bump `plays` by exactly 1 per write, never create, delete, or set it
    // directly.
    match /appStats/{appId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays'])
                    && request.resource.data.plays == resource.data.plays + 1;
    }

    // Per-app emoji reaction counts (🔥 fire / ❤️ heart / 😢 sad). Same
    // idea: a write may only increase the sum of the three counters by
    // exactly 1, and may not touch any other field. Docs are pre-created
    // by scripts/seed-firebase.mjs.
    match /reactions/{appId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fire', 'heart', 'sad'])
                    && reactionSum(request.resource.data) == reactionSum(resource.data) + 1;
    }

    function reactionSum(d) {
      return d.get('fire', 0) + d.get('heart', 0) + d.get('sad', 0);
    }

    // Per-app 5-star ratings, stored as a running sum + count (average =
    // sum/count, computed client-side) rather than one doc per rater — no
    // auth on this site, so there's no per-user doc key to write to
    // anyway. A write may only bump `count` by exactly 1 and `sum` by
    // 1–5 in the same update (i.e. exactly one new rating, worth 1 to 5
    // stars, ever), and may not touch any other field. Docs are
    // pre-created by scripts/seed-firebase.mjs / sync-apps.mjs.
    match /ratings/{appId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sum', 'count'])
                    && request.resource.data.count == resource.data.count + 1
                    && request.resource.data.sum >= resource.data.sum + 1
                    && request.resource.data.sum <= resource.data.sum + 5;
    }

    // Overall site rating (not tied to any one app) — same running
    // sum+count shape as `ratings` above, kept in its own singleton doc so
    // it can never mix into the app-ranking math. Pre-created by
    // scripts/seed-firebase.mjs.
    match /siteRating/overall {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sum', 'count'])
                    && request.resource.data.count == resource.data.count + 1
                    && request.resource.data.sum >= resource.data.sum + 1
                    && request.resource.data.sum <= resource.data.sum + 5;
    }

    // Public feature-request board. Anyone can post an idea (bounded
    // length, starts at 0 votes, status locked to "open" — only an admin
    // via the Console/SDK can mark one planned/shipped/declined, bypassing
    // these rules same as apps/{appId}). Once posted, a request is
    // immutable except for upvotes/downvotes, which may only go up by
    // exactly 1 per write and never both in the same write — mirrors the
    // "no take-backs" reasoning already used for ratings.
    match /featureRequests/{requestId} {
      allow read: if true;
      allow delete: if false;
      allow create: if request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 80
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 300
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() > 0
                    && request.resource.data.authorName.size() <= 24
                    && request.resource.data.upvotes == 0
                    && request.resource.data.downvotes == 0
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdAt == request.time;
      allow update: if (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
                        && request.resource.data.upvotes == resource.data.upvotes + 1
                      ) || (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downvotes'])
                        && request.resource.data.downvotes == resource.data.downvotes + 1
                      );
    }

    // Paid-rank social listing board (see promote.html). Two collections:
    // `socialListings` is the public leaderboard — clients only ever read
    // it, every write comes from the local admin tool using the Admin SDK
    // (bypasses these rules entirely, same as `apps`), only after a bid's
    // payment has been manually verified.
    match /socialListings/{listingId} {
      allow read: if true;
      allow write: if false;
    }

    // `socialListingRequests` is the pending queue a bid submission lands
    // in first, keyed by a deterministic id derived from platform+handle
    // (js/promote.js's listingKey()) rather than an auto-id — so
    // resubmitting the same account overwrites its own pending request
    // instead of piling up duplicates (a real bug hit in practice: a
    // client that briefly re-enabled its submit button let a handful of
    // impatient re-clicks create four identical requests). Unreadable
    // from the client so nobody can see or scrape other people's pending
    // bid amounts/contact notes before the admin reviews them — the admin
    // tool (Admin SDK, local-only, never deployed) is the only thing that
    // ever reads this collection. Approving or rejecting a request
    // deletes it from here (approving also writes the result into
    // `socialListings`), so "still present" always means "still pending."
    // The submitter can also delete their own pending request directly
    // (see `allow delete` below) — a self-service "never mind" before the
    // admin gets to it.
    match /socialListingRequests/{requestId} {
      allow read: if false;
      // A pending request can be withdrawn by anyone who knows its id —
      // same trust model as create/update below: the id is derived from
      // platform+handle (not secret), and there's no auth here to check an
      // "owner" against. This only ever lets someone delete a *pending*
      // request of their own choosing; it can't touch a live listing
      // (socialListings stays fully client-write: false) or anyone else's
      // approval history. The admin's manual review remains the real
      // backstop either way.
      allow delete: if true;
      allow create, update: if request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 40
                    && request.resource.data.platform in ['Instagram', 'YouTube', 'X / Twitter', 'Facebook', 'Other']
                    && request.resource.data.handle is string
                    && request.resource.data.handle.size() > 0
                    && request.resource.data.handle.size() <= 40
                    && request.resource.data.url is string
                    && request.resource.data.url.matches('^https://.+')
                    && request.resource.data.url.size() <= 200
                    && request.resource.data.tagline is string
                    && request.resource.data.tagline.size() <= 140
                    && request.resource.data.bidAmount is int
                    && request.resource.data.bidAmount >= 100
                    && request.resource.data.bidAmount <= 1000000
                    && request.resource.data.contactNote is string
                    && request.resource.data.contactNote.size() <= 140
                    && request.resource.data.submittedAt == request.time;
    }

    // Rejection notices for the promote.html board — written only by the
    // local admin tool (Admin SDK, bypasses these rules) when a request is
    // turned down, keyed by the same deterministic platform+handle id as
    // `socialListingRequests`/`socialListings`. Public read so the
    // submitter's own browser can show *why* without needing to read the
    // (deliberately unreadable) pending queue itself; there's nothing
    // sensitive in a rejection reason that isn't already implied by the
    // account being publicly listed elsewhere.
    match /socialListingRejections/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------- Amplify: paid app rankings (see index.html + amplify.html) ----------------
    // Same shape as the promote.html board above: a public read-only result
    // collection, an unreadable request queue the admin tool (Admin SDK)
    // reviews by hand after a manual UPI payment, and a public rejection
    // notice collection so a submitter's own browser can see why without
    // reading the queue itself.

    // Every listed app's current Decibel (dB) score — seeded once from its
    // existing rating/plays (scripts/seed-app-points.mjs), then only ever
    // moved by an approved appPointRequests entry. Read-only from the
    // client for the same reason `apps` and `socialListings` are: letting
    // clients write their own score would make the whole ranking
    // meaningless.
    match /appPoints/{appId} {
      allow read: if true;
      allow write: if false;
    }

    // A single pending "gift" or "docking" of dB to one app. Deliberately
    // NOT keyed by appId like socialListingRequests — many different
    // people boosting (or docking) the same app over time is the whole
    // point, so every submission gets its own id (client-generated, so the
    // submitter can remember it locally the same way "Your entries" does
    // for promote.html). Unreadable so pending amounts can't be scraped or
    // gamed before review; deletable by anyone who knows the id so a
    // submitter can withdraw their own still-pending request (same trust
    // model as socialListingRequests' delete rule).
    match /appPointRequests/{requestId} {
      allow read: if false;
      allow delete: if true;
      allow create: if request.resource.data.appId is string
                    && request.resource.data.appId.size() > 0
                    && request.resource.data.appName is string
                    && request.resource.data.appName.size() > 0
                    && request.resource.data.appName.size() <= 80
                    && request.resource.data.direction in ['up', 'down']
                    && request.resource.data.amount is int
                    && request.resource.data.amount >= 1
                    && request.resource.data.amount <= 5000
                    && request.resource.data.priceRupees is int
                    && request.resource.data.priceRupees >= 1
                    && request.resource.data.priceRupees <= 1000000
                    && request.resource.data.contactNote is string
                    && request.resource.data.contactNote.size() <= 140
                    && request.resource.data.submittedAt == request.time;
    }

    // Append-only public log of approved dB changes — written by the admin
    // tool at the same time it updates appPoints, purely for the "recent
    // activity" feed. Never edited or deleted once written.
    match /appPointActivity/{activityId} {
      allow read: if true;
      allow write: if false;
    }

    // Rejection notice for one appPointRequests id, same reasoning as
    // socialListingRejections above.
    match /appPointRejections/{requestId} {
      allow read: if true;
      allow write: if false;
    }

    // The public Spotlight carousel — up to 5 currently-featured apps.
    // Read-only; every write comes from the admin tool after a payment is
    // verified. Keyed by appId (one active Spotlight slot per app at a
    // time); the client filters expired ones by comparing featuredUntil to
    // now, so nothing server-side needs to run a cleanup job.
    match /featuredApps/{appId} {
      allow read: if true;
      allow write: if false;
    }

    // A pending Spotlight request, keyed by appId like socialListingRequests
    // — resubmitting for the same app (e.g. renewing) overwrites the
    // pending request instead of piling up duplicates.
    match /featuredAppRequests/{appId} {
      allow read: if false;
      allow delete: if true;
      allow create, update: if request.resource.data.appId is string
                    && request.resource.data.appId.size() > 0
                    && request.resource.data.appName is string
                    && request.resource.data.appName.size() > 0
                    && request.resource.data.appName.size() <= 80
                    && request.resource.data.requestedRank is int
                    && request.resource.data.requestedRank >= 1
                    && request.resource.data.requestedRank <= 5
                    && request.resource.data.days is int
                    && request.resource.data.days >= 1
                    && request.resource.data.days <= 365
                    && request.resource.data.priceRupees is int
                    && request.resource.data.priceRupees >= 1
                    && request.resource.data.priceRupees <= 1000000
                    && request.resource.data.contactNote is string
                    && request.resource.data.contactNote.size() <= 140
                    && request.resource.data.submittedAt == request.time;
    }

    match /featuredAppRejections/{appId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin-editable pricing shown on amplify-submit.html before someone
    // pays — per-rank Spotlight day-rate and per-dB up/down rate. Public
    // read so the form can show real prices; write only via the admin tool,
    // so the site owner can retune prices without touching code.
    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
